{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ficsit-ai-helper/contracts/catalog.schema.json",
  "title": "GameCatalog",
  "description": "Read-only нормализованный каталог. Норматив по ADR-022; проза — ARCHITECTURE.md §5.1, §8.1. Источник истинности — только текущий игровой процесс: состав даёт UModContentRegistry из SML, статус разблокировки читается у игровых подсистем. Сверки двух источников больше нет (ADR-018).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogRevision", "saveKey", "items", "recipes", "machines"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "catalogRevision": {
      "type": "integer",
      "minimum": 0,
      "description": "Повышается при полной сборке (загрузка сохранения, изменение состава модов) и при инкрементальном обновлении разблокировок. Служит для инвалидации кэшей UI."
    },
    "saveKey": { "type": "string", "minLength": 1, "maxLength": 128 },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "recipes": { "type": "array", "items": { "$ref": "#/$defs/recipe" } },
    "machines": { "type": "array", "items": { "$ref": "#/$defs/machine" } },
    "schematics": { "type": "array", "items": { "$ref": "#/$defs/schematic" } }
  },
  "$defs": {
    "className": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*_C$",
      "description": "Устойчивое игровое className — единственный ключ. Отображаемое имя хранится отдельным полем и не используется для идентификации."
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "displayName", "form"],
      "properties": {
        "className": { "$ref": "#/$defs/className" },
        "displayName": { "type": "string", "minLength": 1 },
        "form": { "enum": ["solid", "liquid", "gas"] },
        "stackSize": { "type": "integer", "minimum": 1 },
        "energyMJ": { "type": "number", "minimum": 0 },
        "isRadioactive": { "type": "boolean" },
        "isResource": { "type": "boolean", "description": "Добывается из мира, а не производится." }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "displayName", "durationSec", "ingredients", "products", "producedIn", "isAlternate", "unlocked"],
      "properties": {
        "className": { "$ref": "#/$defs/className" },
        "displayName": { "type": "string", "minLength": 1 },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 },
        "ingredients": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "products": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/port" } },
        "producedIn": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/className" },
          "description": "Рецепт может производиться в нескольких классах машин."
        },
        "isAlternate": { "type": "boolean" },
        "unlocked": {
          "type": "boolean",
          "description": "Инвариант §5.1: известный рецепт ≠ разблокированный в этом сохранении. Поддерживается одним кодом, а не сверкой двух источников."
        },
        "isVanilla": {
          "type": "boolean",
          "description": "Из UModContentRegistry::IsRecipeVanilla. Позволяет отличать модовый контент от игрового."
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "amount"],
      "properties": {
        "item": { "$ref": "#/$defs/className" },
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "amountPerMin": {
          "type": "number",
          "minimum": 0,
          "description": "Производная величина: amount × 60 / durationSec. Хранится для удобства, нормативом остаётся amount."
        }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "displayName", "family", "powerMW", "buildable"],
      "properties": {
        "className": { "$ref": "#/$defs/className" },
        "displayName": { "type": "string", "minLength": 1 },
        "family": { "enum": ["extractor", "smelter", "constructor", "assembler", "manufacturer", "refinery", "blender", "packager", "particle", "generator", "other"] },
        "powerMW": { "type": "number", "description": "Отрицательное значение — машина вырабатывает энергию." },
        "buildable": { "type": "boolean" },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "beltIn": { "type": "integer", "minimum": 0 },
            "beltOut": { "type": "integer", "minimum": 0 },
            "pipeIn": { "type": "integer", "minimum": 0 },
            "pipeOut": { "type": "integer", "minimum": 0 }
          }
        },
        "maxPowerShards": { "type": "integer", "minimum": 0, "maximum": 3 },
        "maxSomersloops": { "type": "integer", "minimum": 0, "maximum": 4 },
        "footprint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "exclusiveMinimum": 0 },
            "y": { "type": "number", "exclusiveMinimum": 0 },
            "z": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "const": "foundations" }
          }
        }
      }
    },
    "schematic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "displayName", "purchased"],
      "properties": {
        "className": { "$ref": "#/$defs/className" },
        "displayName": { "type": "string", "minLength": 1 },
        "tier": { "type": "integer", "minimum": 0 },
        "purchased": { "type": "boolean" },
        "unlocksRecipes": { "type": "array", "items": { "$ref": "#/$defs/className" } }
      }
    }
  }
}
