// FICSIT AI v2.1-draft — компонентная схема.
// UI — переиспользуемые экранные модули в хостах; в v1.0 хост — AI Terminal. Планировщик — обёртка с заглушкой.
// Два рантайма: игровой процесс и локальный сайдкар (адаптер + vanilla Foreman).
// Входящих слушателей в игровом процессе нет: мод сам подключается к адаптеру.
// Рендер: dot -Tpng -Gdpi=150 components.dot -o components.png
digraph G {
  graph [rankdir=TB, compound=true, nodesep=.30, ranksep=.45, pad=.16, bgcolor="white",
         fontname="DejaVu Sans", splines=ortho];
  node  [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10,
         color="#A8B3BD", fillcolor="#F6F8FA", fontcolor="#24303A", margin=".12,.08"];
  edge  [color="#718291", penwidth=1.2, arrowsize=.6];

  subgraph cluster_game {
    label="Игровой процесс: Satisfactory 1.2 + SML + FicsitAI (одиночная игра)";
    fontsize=12; fontname="DejaVu Sans"; fontcolor="#263B47"; color="#CDD5DB"; style="rounded";

    subgraph cluster_present {
      label="Презентационный слой"; fontsize=10; fontcolor="#54646F"; color="#DFE5EA"; style="rounded,dashed";
      terminal  [label="AI Terminal — хост v1.0\nстроительный объект · питание · E", fillcolor="#F9E6CA", color="#D69A53"];
      equipment [label="AI Assistant — хост после v1.0\nручной слот · те же модули", fillcolor="#EDF0F2", color="#B9C2CA", style="rounded,filled,dashed"];
      ui        [label="Экранные модули (IScreenModule)\nDashboard · Chat · Notes · Work Orders · Screens"];
      graphview [label="Обёртки Planning и Graph (IPlanView)\nv1.0 — заглушка · UI подключаемый"];
      hud       [label="HUD\nвместе с AI Assistant", fillcolor="#EDF0F2", color="#B9C2CA", style="rounded,filled,dashed"];
      rt        [label="Render target → меш терминала\nобновление по renderRevision"];
    }

    subgraph cluster_auth {
      label="Authority-слой — каждый внешний вызов проходит Validator"; fontsize=10;
      fontcolor="#54646F"; color="#D8BFA0"; style="rounded,dashed";
      validator [label="OperationRegistry + Validator\nодни операции для UI и модели\nсхема · лимиты · живой каталог", fillcolor="#FBEEDC", color="#C98F4C"];
      planner   [label="PlannerGateway (обёртка)\nPlanRequest → ProductionPlan\nv1.0 — заглушка"];
      provider  [label="Внешний провайдер\nпервый кандидат — ядро SBC", fillcolor="#EDF0F2", color="#B9C2CA", style="rounded,filled,dashed"];
      provider -> planner [style=dashed];
      catalog   [label="CatalogProvider\nAFGRecipeManager · SML classes"];
      telemetry [label="TelemetrySampler\nснапшоты, агрегация вне GameThread"];
      bpcore    [label="Factory Spawner core (адаптация)\nv1.1 · чертёж в библиотеку", fillcolor="#EDF0F2", color="#B9C2CA", style="rounded,filled,dashed"];
      validator -> bpcore [style=dashed];
    }

    link  [label="Канал к адаптеру\nисходящее соединение · loopback · токен", fillcolor="#E6F1F3", color="#7FA7B0"];
    save  [label="Состояние в сохранении\nsaveId · планы · экраны · заметки", shape=cylinder];
    files [label="Локальные файлы по saveId\nтелеметрия · кэш рендера", shape=cylinder];

    terminal -> ui; equipment -> ui [style=dashed]; equipment -> hud [style=dashed];
    terminal -> graphview; graphview -> planner; terminal -> rt;
    ui -> validator [label="ручные операции", fontsize=9]; hud -> telemetry;
    planner -> validator;
    ui -> save [dir=both]; telemetry -> files; rt -> files [style=dotted];
    catalog -> provider [style=dotted];
    link -> validator [label="те же операции от модели", fontsize=9];
    ui -> link [label="чат", fontsize=9];
  }

  subgraph cluster_side {
    label="Локальный сайдкар (один установщик · запускается модом · loopback)";
    fontsize=12; fontname="DejaVu Sans"; fontcolor="#263B47"; color="#CDD5DB"; style="rounded";
    adapter [label="Адаптер\nMCP-сервер для Foreman · белый список инструментов\nавторизация · стабильный API для мода", fillcolor="#E6F1F3", color="#7FA7B0"];
    foreman [label="FICSIT Foreman ff-server — vanilla\nchat SSE · MCP client · Work Orders", fillcolor="#E6F1F3", color="#7FA7B0"];
    sfmcp   [label="sf-mcp (Foreman)\nсправочные данные · .sav", fillcolor="#F2F4F6", color="#B9C2CA"];
    fdb     [label="Foreman DB (SQLite)\nаккаунт · переписка · Work Orders", shape=cylinder];
    voice   [label="STT + TTS\nv1.3", fillcolor="#EDF0F2", color="#B9C2CA", style="rounded,filled,dashed"];
    foreman -> adapter [label="MCP_URL", fontsize=9];
    adapter -> foreman [label="chat · Work Orders REST · сессия", fontsize=9];
    adapter -> sfmcp [label="прокси", fontsize=9];
    foreman -> fdb [dir=both];
    foreman -> voice [dir=both, style=dashed];
  }

  llm [label="LLM-провайдер\nключ хранится у сайдкара", shape=note, fillcolor="#F2F4F6", color="#B9C2CA"];

  link    -> adapter [dir=both, label="WebSocket / long-poll", fontsize=9];
  foreman -> llm     [dir=both, style=dashed];
}
